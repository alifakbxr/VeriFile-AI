# Never commit personal Hugging Face tokens or user file contents.
GEMMA_MODEL_ID=google/gemma-4-E2B-it
GEMMA_4BIT=1
# For CPUs: unrealistic latency; only if you consciously accept very slow inference.
GEMMA_ALLOW_CPU=0
# Public share links can expose private uploaded documents. Disabled by default.
GRADIO_SHARE=0
