# Never commit personal Hugging Face tokens, Gemini API keys, or user file contents.
GEMMA_MODEL_ID=google/gemma-4-E2B-it
GEMMA_4BIT=1
# For CPUs: unrealistic latency; only if you consciously accept very slow inference.
GEMMA_ALLOW_CPU=0

# Optional Gemini API fallback when CUDA GPU / local Gemma 4 is unavailable:
# GEMINI_API_KEY=your_api_key_here
GEMINI_FALLBACK=1
GEMINI_MODEL_ID=gemini-2.5-flash
# Set GEMINI_ONLY=1 to skip local Gemma 4 and call Gemini API directly:
GEMINI_ONLY=0

# Public share links can expose private uploaded documents. Disabled by default.
GRADIO_SHARE=0

# Web interface network binding & optional HTTP Basic Auth
VERIFILE_HOST=127.0.0.1
VERIFILE_PORT=7860
# VERIFILE_AUTH_USER=admin
# VERIFILE_AUTH_PASS=change_this_secure_password
